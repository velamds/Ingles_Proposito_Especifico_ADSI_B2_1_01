rect": 1, "selected": 0, "_data": [{"type": "text", "content": ""}], "id": 1}], "id": 0}], "type": "RSLT", "template_override": 1, "id": 10}, {"stimuli_ids": [], "_data": [{"contents": [{"type": "text", "content": " Explaining tracking defects system."}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Take Away"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "", "incorrect_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "allowed_attempts": 2}}, {"contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self-Assessment."}], "type": "post_instructions"}, {"contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}], "type": "learning_skills"}], "questions": [{"_data": [{"contents": [{"type": "pdf", "content": "enpe8n8le01ob08re7pdf01.pdf"}], "type": "question"}], "responses": [{"correct": 1, "selected": 0, "_data": [{"type": "text", "content": ""}], "id": 0}], "id": 0}], "type": "DWS", "template_override": 1, "id": 11}], "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"_data": [], "title": "", "type": "audio", "template_override": 1, "id": 1, "contents": [{"value": {"audiosrc": "enpe8n8le01ob08re2aud01", "images": [{"time": "0", "image": "enpe8n8le01ob08re2img01.jpg", "id": 0, "text": "We've been assessing the software development processes of a company that's having issues with tracking and fixing defects.  </br> So far, we could say that their advanced bug tracking system allows them to enter detailed data about the detected bugs. Nevertheless, they must have wasted a lot of time entering the information about these defects since this process can be time-demanding. Let's not forget that bug tracking systems help the team collect and track data in a database for simplifying the tracking and the fixing processes. However, they may have misunderstood the real function of this system, which is to facilitate work and not to demand the team to enter every possible piece of information about all the bugs they find. They might not have realized that tracking bugs that aren't going to get fixed is harmful for the process since this is a waste of time for the team."}, {"time": "56000", "image": "enpe8n8le01ob08re2img02.jpg", "id": 1, "text": "The company might have disregarded the advantages of direct communication, in which both developers and testers can discuss face to face and clear up any misunderstandings; whereas, defect tracking can sometimes mislead to a wrong interpretation of one another's words.  I felt tension between some of the members, and this may have been due to the fact that a report is a poor means of communication and both parties can feel their work is being underestimated by the other."}, {"time": "85000", "image": "enpe8n8le01ob08re2img03.jpg", "id": 2, "text": "Unfortunately they didn't grasp these problems before. They must have taken the issues regarding defect metrics for granted. Furthermore, defect metrics can be detrimental if they are used for measuring the tester's productivity. As not everyone knows how to properly write a bug report, some users prefer not to report certain bugs. Therefore, their metrics could have indicated a lower amount of defects, and they must have wrongly inferred that the product's quality was improving."}], "coverimg": "enpe8n8le01ob08re2img01.jpg"}, "type": "slideshow"}]}], "type": "scholar", "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "id": 0}]}